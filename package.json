{
  "name": "hallucinate",
  "version": "1.0.0",
  "description": "Psychedelic, audio-reactive WebGL visuals for your music",
  "keywords": [
    "webgl2",
    "glsl",
    "shaders",
    "audio-visualizer",
    "music-visualizer",
    "audio-reactive",
    "vj",
    "generative-art",
    "creative-coding",
    "live-coding",
    "web-audio-api",
    "react",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/snuffish/hallucinate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snuffish/hallucinate.git"
  },
  "bugs": {
    "url": "https://github.com/snuffish/hallucinate/issues"
  },
  "license": "MIT",
  "author": "Snuffish",
  "type": "module",
  "private": true,
  "main": "dist-desktop/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "node desktop/dev.mjs",
    "build:desktop": "vite build && vite build -c vite.desktop.config.ts",
    "package": "npm run build:desktop && electron-builder",
    "package:dir": "npm run build:desktop && electron-builder --dir",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test --project chromium",
    "test:e2e:desktop": "npm run build:desktop && playwright test --project desktop",
    "perf": "node perf/measure.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@playwright/test": "latest",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-hotkeys-devtools": "^0.10.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tanstack/ai": "^0.69.0",
    "@tanstack/ai-anthropic": "^0.22.0",
    "@tanstack/ai-claude-code": "^0.9.0",
    "@tanstack/ai-client": "^0.39.3",
    "@tanstack/ai-react": "^0.30.4",
    "@tanstack/ai-sandbox": "^0.5.23",
    "@tanstack/ai-sandbox-local-process": "^0.2.6",
    "@tanstack/highlight": "^1.1.0",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/react-hotkeys": "^0.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  }
}
